# ==== Supabase 配置（必填）====
# Supabase 控制台 → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 填 "Publishable key"（旧版界面叫 anon public key），两种格式都支持：
#   sb_publishable_xxxxx...   或   eyJhbGciOi...
# ⚠️ 绝对不要填 "Secret key"（sb_secret_xxx）/ service_role，那是最高权限
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ==== 可选 ====
# 附件所在的 Storage bucket 名称（要和 supabase/schema.sql 里创建的一致）
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=chat-attachments

# 时间显示使用的时区。服务端和浏览器都用同一个值渲染，避免 hydration 不一致。
NEXT_PUBLIC_TIMEZONE=Asia/Shanghai

# 单文件上传上限（字节）。默认 10MB。
# 部署到 Vercel 时建议设成 4194304（4MB）—— Vercel 函数请求体上限是 4.5MB。
# NEXT_PUBLIC_MAX_UPLOAD_BYTES=4194304

# ==== 部署到线上时才需要（本地开发不用管）====
# 【服务端】直连 Supabase 的地址。部署在海外（Vercel / 香港 VPS）时填官方地址，
# 让它少绕一层反代。本地不填时 = NEXT_PUBLIC_SUPABASE_URL。
# SUPABASE_URL_SERVER=https://xxxxxxxxxxxx.supabase.co
#
# 而 NEXT_PUBLIC_SUPABASE_URL 在线上要指向你自己的反代域名
# （Cloudflare Worker 或 nginx），例如 https://sb.example.com
# 详见 DEPLOY.md
